<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MedAid Home E-Pharmacy</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body { font-family: Arial, sans-serif; }
        .hero { background: linear-gradient(to right, #007bff, #28a745); color: white; padding: 100px 0; }
        .product-card { transition: transform 0.3s; }
        .product-card:hover { transform: scale(1.05); }
        footer { background: #f8f9fa; padding: 20px 0; }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container">
            <a class="navbar-brand" href="#"><i class="fas fa-pills"></i> MedAid Home E-Pharmacy</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="#home">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="#products">Products</a></li>
                    <li class="nav-item"><a class="nav-link" href="#about">About</a></li>
                    <li class="nav-item"><a class="nav-link" href="#contact">Contact</a></li>
                    <li class="nav-item"><a class="nav-link" href="#"><i class="fas fa-shopping-cart"></i> Cart</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="home" class="hero text-center">
        <div class="container">
            <h1>Welcome to MedAid Home E-Pharmacy</h1>
            <p>Your trusted source for medications delivered to your door. Fast, safe, and reliable.</p>
            <a href="#products" class="btn btn-light btn-lg">Shop Now</a>
        </div>
    </section>

    <!-- Featured Products -->
    <section id="products" class="py-5">
        <div class="container">
            <h2 class="text-center mb-4">Featured Products</h2>
            <div class="row">
                <div class="col-md-4">
                    <div class="card product-card">
                        <img src="https://via.placeholder.com/300x200?text=Medicine+1" class="card-img-top" alt="Product 1">
                        <div class="card-body">
                            <h5 class="card-title">Pain Relief Tablets</h5>
                            <p class="card-text">Effective relief for headaches and body pain.</p>
                            <a href="#" class="btn btn-primary">Add to Cart</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card product-card">
                        <img src="https://via.placeholder.com/300x200?text=Medicine+2" class="card-img-top" alt="Product 2">
                        <div class="card-body">
                            <h5 class="card-title">Vitamin Supplements</h5>
                            <p class="card-text">Boost your immunity with our daily vitamins.</p>
                            <a href="#" class="btn btn-primary">Add to Cart</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card product-card">
                        <img src="https://via.placeholder.com/300x200?text=Medicine+3" class="card-img-top" alt="Product 3">
                        <div class="card-body">
                            <h5 class="card-title">Cold & Flu Remedies</h5>
                            <p class="card-text">Quick relief from cold symptoms.</p>
                            <a href="#" class="btn btn-primary">Add to Cart</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="bg-light py-5">
        <div class="container">
            <h2 class="text-center mb-4">About MedAid</h2>
            <p class="text-center">MedAid Home E-Pharmacy is committed to providing high-quality medications and health products with convenient home delivery. Our licensed pharmacists ensure safety and accuracy in every order.</p>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="container text-center">
            <p>&copy; 2023 MedAid Home E-Pharmacy. All rights reserved.</p>
            <p><i class="fas fa-phone"></i> Call us: 1-800-MEDAID | <i class="fas fa-envelope"></i> info@medaid.com</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
